//--------------------------------------------------------------------
// Microserviço de Revisões de Provas
// Responsável pela gestão de pedidos de revisão de correção
//--------------------------------------------------------------------

Table pedidos_revisao {
  id int [pk, increment]
  classificacao_id int [not null, note: 'ID da classificação a ser revista']
  aluno_id int [not null]
  docente_responsavel_id int [not null]
  justificacao text [not null]
  estado estado_revisao [not null, default: 'AGUARDA_APROVACAO']
  
  // Decisão do docente
  aprovado boolean [note: 'null=pendente, true=aprovado, false=rejeitado']
  justificacao_docente text [note: 'Justificação da aprovação/rejeição']
  data_decisao_aprovacao timestamp
  
  // Resultado da revisão (se aprovado)
  nota_original decimal(4,2)
  nota_revista decimal(4,2)
  observacoes_revisao text
  data_revisao timestamp
  
  data_submissao timestamp [not null]
  prazo_resposta timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (classificacao_id)
    (aluno_id)
    (estado)
  }
}

Table documentos_revisao {
  id int [pk, increment]
  pedido_id int [ref: > pedidos_revisao.id]
  tipo tipo_documento [not null]
  nome_ficheiro varchar(255) [not null]
  url_documento text [not null]
  uploaded_by int [not null]
  data_upload timestamp [not null]
  created_at timestamp
}

Enum estado_revisao {
  AGUARDA_APROVACAO [note: 'Aguarda decisão do docente']
  REJEITADO [note: 'Docente rejeitou o pedido']
  EM_REVISAO [note: 'Aprovado, docente a rever prova']
  CONCLUIDO [note: 'Revisão feita, nota atualizada']
  CANCELADO [note: 'Cancelado pelo aluno']
}

Enum tipo_documento {
  RESOLUCAO [note: 'Prova do aluno']
  CRITERIOS [note: 'Critérios de correção']
  JUSTIFICATIVA [note: 'Documento adicional']
}