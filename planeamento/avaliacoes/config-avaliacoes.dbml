//--------------------------------------------------------------------
// Microserviço de Configuração de Avaliações
// Responsável pela definição da estrutura de avaliação das UCs
//--------------------------------------------------------------------

Table escalas_classificacao {
  id int [pk, increment]
  unidade_curricular_id int [not null, note: 'ID da UC no serviço de Gestão Académica']
  ano_letivo_id int [not null, note: 'ID do ano letivo']
  descricao text [note: 'Descrição da fórmula de avaliação']
  estado estado_escala [not null, default: 'RASCUNHO']
  data_aprovacao timestamp
  versao int [not null, default: 1, note: 'Controle de versão da escala']
  created_at timestamp
  updated_at timestamp
  
  indexes {
    (unidade_curricular_id, ano_letivo_id) [unique]
  }

  note: 'Define as regras de avaliação para uma UC num ano letivo'
}

Table componentes_avaliacao {
  id int [pk, increment]
  escala_id int [ref: > escalas_classificacao.id]
  nome varchar(100) [not null, note: 'Nome da componente']
  peso decimal(5,4) [not null, note: 'Peso na nota final (0-1)']
  nota_minima decimal(4,2) [note: 'Nota mínima necessária, se aplicável']
  created_at timestamp
  updated_at timestamp

  note: 'Componentes que formam a avaliação (ex: frequência, exame)'
}

Table momentos_avaliacao {
  id int [pk, increment]
  componente_id int [ref: > componentes_avaliacao.id]
  titulo varchar(255) [not null, note: 'Título do momento de avaliação']
  data_realizacao timestamp
  duracao_minutos int [note: 'Duração prevista em minutos']
  sala varchar(50) [note: 'Local de realização']
  estado estado_momento [not null, default: 'AGENDADO']
  created_at timestamp
  updated_at timestamp
  
  note: 'Momentos específicos de avaliação'
}

Enum estado_escala {
  RASCUNHO [note: 'Em elaboração']
  SUBMETIDA [note: 'Aguardando aprovação']
  APROVADA [note: 'Aprovada e em vigor']
  ARQUIVADA [note: 'Versão anterior arquivada']
}

Enum estado_momento {
  AGENDADO [note: 'Programado para realização']
  EM_CURSO [note: 'Em andamento']
  REALIZADO [note: 'Concluído']
  CANCELADO [note: 'Cancelado']
}