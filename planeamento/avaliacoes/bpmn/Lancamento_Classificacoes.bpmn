    <bpmn:textAnnotation id="textAnnotation_kSqyKA" textFormat="">
      <bpmn:documentation id="documentation_7ttmOQ" />
      <bpmn:text>O docente utiliza o sistema (via POST /classificacoes) para inserir as notas dos alunos. As classificações são criadas com o estado inicial LANCADA</bpmn:text>
