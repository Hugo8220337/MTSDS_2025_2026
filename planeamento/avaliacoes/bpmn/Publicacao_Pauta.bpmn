<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_3" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_PublicacaoPauta" isExecutable="false">
    <bpmn:startEvent id="StartEvent_FimEpoca" name="Fim da Época de Avaliação">
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CriarPauta" name="Criar Pauta (EM_PREPARACAO)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GerarResultados" name="Gerar Resultados da Pauta">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PublicarProvisoria" name="Publicar Pauta (PROVISORIA)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_TimerRevisao" name="Período para Pedidos de Revisão">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_RecolherAssinaturas" name="Recolher Assinaturas (Regente, etc.)">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PublicarDefinitiva" name="Publicar Pauta (PUBLICADA)">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FecharPauta" name="Fechar Pauta (FECHADA)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_PautaFechada" name="Pauta Fechada e Arquivada">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="StartEvent_FimEpoca" targetRef="Task_CriarPauta" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CriarPauta" targetRef="Task_GerarResultados" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_GerarResultados" targetRef="Task_PublicarProvisoria" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PublicarProvisoria" targetRef="Event_TimerRevisao" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Event_TimerRevisao" targetRef="Task_RecolherAssinaturas" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_RecolherAssinaturas" targetRef="Task_PublicarDefinitiva" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_PublicarDefinitiva" targetRef="Task_FecharPauta" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_FecharPauta" targetRef="EndEvent_PautaFechada" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_3">
    <bpmndi:BPMNPlane id="BPMNPlane_3" bpmnElement="Process_PublicacaoPauta">
      <bpmndi:BPMNShape id="Shape_StartEvent_FimEpoca" bpmnElement="StartEvent_FimEpoca">
        <dc:Bounds x="162" y="162" width="36" height="36" />
