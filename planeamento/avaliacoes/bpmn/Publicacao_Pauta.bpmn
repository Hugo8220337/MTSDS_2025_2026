      <bpmndi:BPMNShape id="Shape_Task_RecolherAssinaturas" bpmnElement="Task_RecolherAssinaturas">
        <dc:Bounds x="790" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PublicarDefinitiva" bpmnElement="Task_PublicarDefinitiva">
        <dc:Bounds x="940" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_FecharPauta" bpmnElement="Task_FecharPauta">
        <dc:Bounds x="1090" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_PautaFechada" bpmnElement="EndEvent_PautaFechada">
        <dc:Bounds x="1242" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1219" y="205" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="198" y="180" />
        <di:waypoint x="250" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="350" y="180" />
        <di:waypoint x="400" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="500" y="180" />
        <di:waypoint x="550" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="650" y="180" />
