// Candidaturas DGES Database Model

// Tabela que armazena informações dos cursos como aparecem no sistema DGES
Table cursos_dges {
  id integer [pk]
  codigo_dges string [note: 'Código único do curso no sistema DGES']
  nome_dges string [note: 'Nome oficial do curso na DGES']
  ano_letivo string [note: 'Ano letivo do curso (ex: 2025/2026)']
  created_at timestamp
  updated_at timestamp

  note: 'Catálogo de cursos da DGES e os seus códigos oficiais'
}

// Tabela que mapeia cursos DGES para cursos internos da instituição
Table mapping_cursos {
  id integer [pk]
  curso_dges_id integer [ref: > cursos_dges.id, note: 'Referência ao curso no sistema DGES']
  curso_interno_id string [note: 'Código do curso no sistema interno da instituição']
  ano_letivo string [note: 'Ano letivo do mapeamento']
  created_at timestamp
  updated_at timestamp

  note: 'Mapeamento entre códigos de cursos DGES e códigos internos da instituição'
}

// Tabela que armazena os alunos colocados pela DGES
Table colocacoes_dges {
  id integer [pk]
  nif string [note: 'NIF/Documento de identificação do aluno']
  nome string [note: 'Nome completo do aluno']
  curso_dges_id integer [ref: > cursos_dges.id, note: 'Curso em que o aluno foi colocado']
  fase integer [note: 'Fase do concurso nacional (1ª, 2ª ou 3ª fase)']
  ano_letivo string [note: 'Ano letivo da colocação']
  estado estado_colocacao [note: 'Estado atual da colocação']
  data_importacao timestamp [note: 'Data em que o registro foi importado do arquivo DGES']
  created_at timestamp
  updated_at timestamp

  note: 'Registo de alunos colocados através do sistema DGES
  Quando o estado for COLOCADO_DGES, deve ser iniciado o processo de matrícula 
  para poder ter o seu registo na tabela de aluno na gestão académica.'
}

Enum estado_colocacao {
  IMPORTADO
  PROCESSADO
  ERRO
  COLOCADO_DGES
}