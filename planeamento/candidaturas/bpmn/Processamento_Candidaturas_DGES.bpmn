  <bpmn:process id="Process_ProcessamentoDGES" processType="Public" isExecutable="true">
    <bpmn:documentation id="documentation_HVM3bQ" />
    <bpmn:extensionElements>
      <open-bpmn:auto-align />
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_FicheiroRecebido" name="Ficheiro DGES Recebido">
      <bpmn:documentation id="documentation_PACsrQ" />
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ImportarColocacoes" name="Importar Colocações do Ficheiro">
      <bpmn:documentation id="documentation_myJDmg" />
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="import-dges-file" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess_ProcessarAluno" name="Processar Aluno Colocado">
      <bpmn:documentation id="documentation_0qHSRA" />
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">colocacoes</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="SubStart_Aluno">
        <bpmn:documentation id="documentation_yBhUuw" />
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_MapearCurso" name="Mapear Curso DGES para Curso Interno">
        <bpmn:documentation id="documentation_POHvTA" />
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="map-dges-course" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_CursoMapeado" name="Curso Mapeado?">
        <bpmn:documentation id="documentation_rPhP9g" />
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_Sim</bpmn:outgoing>
        <bpmn:outgoing>Flow_Nao</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_CriarMatricula" name="Criar Processo de Matrícula">
        <bpmn:documentation id="documentation_a0uS4A" />
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="create-enrollment-process" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Sim</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_MarcarErro" name="Marcar Colocação com Erro">
        <bpmn:documentation id="documentation_snAx9w" />
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="update-placement-status-error" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Nao</bpmn:incoming>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="Task_NotificarAdmin" name="Notificar Administrador">
        <bpmn:documentation id="documentation_WRa0NA" />
        <bpmn:incoming>Flow_6</bpmn:incoming>
        <bpmn:outgoing>Flow_EndErro</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="SubEnd_Erro" name="Erro no Processamento">
        <bpmn:documentation id="documentation_Qq5Vhg" />
        <bpmn:incoming>Flow_EndErro</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="SubEnd_Sucesso" name="Processo de Matrícula Criado">
        <bpmn:documentation id="documentation_dWto3A" />
        <bpmn:incoming>Flow_5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_3" sourceRef="SubStart_Aluno" targetRef="Task_MapearCurso">
        <bpmn:documentation id="documentation_Q7gHOg" />
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_MapearCurso" targetRef="Gateway_CursoMapeado">
        <bpmn:documentation id="documentation_xIpmDQ" />
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Sim" name="Sim" sourceRef="Gateway_CursoMapeado" targetRef="Task_CriarMatricula">
        <bpmn:documentation id="documentation_SI0zxw" />
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Nao" name="Não" sourceRef="Gateway_CursoMapeado" targetRef="Task_MarcarErro">
        <bpmn:documentation id="documentation_f3kzSA" />
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CriarMatricula" targetRef="SubEnd_Sucesso">
        <bpmn:documentation id="documentation_6reKKQ" />
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_MarcarErro" targetRef="Task_NotificarAdmin">
        <bpmn:documentation id="documentation_p30OTA" />
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_EndErro" sourceRef="Task_NotificarAdmin" targetRef="SubEnd_Erro">
        <bpmn:documentation id="documentation_PXNuwg" />
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent_ProcessoConcluido" name="Processamento Concluído">
      <bpmn:documentation id="documentation_VHN7sA" />
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_FicheiroRecebido" targetRef="Task_ImportarColocacoes">
