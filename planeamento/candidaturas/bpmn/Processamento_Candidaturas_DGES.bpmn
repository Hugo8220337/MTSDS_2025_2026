    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="SubProcess_ProcessarAluno" targetRef="EndEvent_ProcessoConcluido">
      <bpmn:documentation id="documentation_sHwB8A" />
    </bpmn:sequenceFlow>
  </bpmn:process>
