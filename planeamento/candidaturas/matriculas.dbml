// Matrículas Database Model

// Processos de matrícula dos alunos
Table processos_matricula {
  id integer [pk]
  nif string [note: 'NIF/Documento de identificação do aluno']
  nome string [note: 'Nome completo do aluno']
  curso_id string [note: 'Código do curso no sistema interno']
  ano_letivo string [note: 'Ano letivo da matrícula']
  colocacao_dges_id integer [null, note: 'ID da colocação DGES (se origem = DGES)']
  candidatura_local_id integer [null, note: 'ID da candidatura local (se origem = LOCAL)']
  origem origem_matricula [note: 'Origem do aluno (DGES ou concurso local)']
  estado estado_matricula [note: 'Estado atual do processo de matrícula']
  data_criacao timestamp [note: 'Data de criação do processo de matrícula']
  created_at timestamp
  updated_at timestamp

    note: 'Processos de matrícula de alunos, tanto DGES quanto concursos locais.
  Criado automaticamente quando:
  - colocacoes_dges.estado = COLOCADO_DGES (origem = DGES)
  - candidaturas.estado = APROVADA e opcoes_curso.estado = COLOCADO (origem = LOCAL)'
}

// Documentos necessários para matrícula
Table documentos_matricula {
  id integer [pk]
  processo_matricula_id integer [ref: > processos_matricula.id, note: 'Processo de matrícula ao qual o documento pertence']
  tipo_documento string [note: 'Tipo do documento (CC, foto, certificado, etc)']
  url_documento string [note: 'URL para acesso ao documento no sistema de arquivos']
  estado estado_documento [note: 'Estado de validação do documento']
  created_at timestamp
  updated_at timestamp

  note: 'Documentos necessários para efetivação da matrícula'
}



Enum origem_matricula {
  DGES
  LOCAL
}

Enum estado_matricula {
  CRIADA
  DOCUMENTOS_PENDENTES
  EM_PROCESSAMENTO
  MATRICULADO
  ANULADA
  ERRO
}

Enum estado_documento {
  PENDENTE
  VALIDO
  INVALIDO
  REJEITADO
}
