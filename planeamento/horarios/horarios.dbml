//--------------------------------------------------------------------
// Tabelas para o Microserviço de Horários
// Responsável por gerir alocação de salas e horários das aulas.
//--------------------------------------------------------------------

// --- Entidades Estruturais ---

table Sala {
  id int [pk, increment]
  edificio varchar(50) [not null, note: 'ex: A, B, C']
  piso int [not null]
  numero varchar(20) [not null, note: 'ex: 201, LAB1']
  tipo varchar(50) [not null, note: 'ex: SALA_AULA, LABORATORIO, AUDITORIO']
  capacidade int [not null]
  equipamento text [note: 'Lista de equipamentos disponíveis na sala']
  escola_id int [not null, note: 'FK para Escola no serviço de Gestão Académica']
  
  indexes {
    (edificio, piso, numero) [unique]
  }
  
  note: 'Espaços físicos onde decorrem as aulas'
}

table SlotHorario {
  id int [pk, increment]
  hora_inicio time [not null]
  hora_fim time [not null]
  duracao_minutos int [not null]
  tipo_slot varchar(50) [not null, note: 'ex: AULA_NORMAL, INTERVALO, ALMOCO']
  
  indexes {
    (hora_inicio, hora_fim) [unique]
  }
  
  note: 'Períodos de tempo pré-definidos para aulas'
}

table Aula {
  id int [pk, increment]
  turma_id int [not null, note: 'FK para Turma no serviço de Gestão Académica']
  docente_id int [not null, note: 'FK para Docente no serviço de Gestão Académica']
  sala_id int [ref: > Sala.id]
  slot_horario_id int [ref: > SlotHorario.id]
  dia_semana int [not null, note: '1=Segunda, 2=Terça, etc.']
  tipo_aula varchar(50) [not null, note: 'ex: TEORICA, PRATICA, TEORICO_PRATICA']
  data_inicio date [not null, note: 'Data da primeira aula']
  data_fim date [not null, note: 'Data da última aula']
  
  indexes {
    (sala_id, slot_horario_id, dia_semana) [unique, note: 'Evita conflitos de sala']
    (docente_id, slot_horario_id, dia_semana) [unique, note: 'Evita conflitos de docente']
  }
  
  note: 'Ocorrência regular de uma aula (dia/hora/local)'
}

table Excecao {
  id int [pk, increment]
  aula_id int [ref: > Aula.id]
  data date [not null]
  tipo varchar(50) [not null, note: 'ex: FERIADO, ALTERACAO_SALA, REPOSICAO']
  sala_id_alternativa int [ref: > Sala.id, note: 'Se for alteração de sala']
  slot_horario_id_alternativo int [ref: > SlotHorario.id, note: 'Se for alteração de horário']
  observacoes text
  
  indexes {
    (aula_id, data) [unique]
  }
  
  note: 'Regista exceções ao horário normal (feriados, alterações pontuais)'
}

table Reserva {
  id int [pk, increment]
  sala_id int [ref: > Sala.id, not null]
  titulo varchar(255) [not null, note: 'ex: Teste de Programação Web']
  data_hora_inicio timestamp [not null]
  data_hora_fim timestamp [not null]
  responsavel_id int [note: 'Docente/funcionário que reservou']
  observacoes text
  
  indexes {
    (sala_id, data_hora_inicio)
    (data_hora_inicio)
  }
  
  note: 'Reservas pontuais de salas para testes, reuniões, eventos, etc.'
}

//--------------------------------------------------------------------
// Representação de Entidades de Microserviços Externos
//--------------------------------------------------------------------

table UnidadeCurricular_Externo as UnidadeCurricular {
  id int [pk]
  codigo_uc varchar
  nome varchar
}

table AnoLetivo_Externo as AnoLetivo {
  id int [pk]
  ano varchar
}

table Docente_Externo as Docente {
  id int [pk]
  numero_mecanografico varchar
}

table Inscricao_Externo as Inscricao {
  id int [pk]
  aluno_id int
  unidade_curricular_id int
  ano_letivo_id int
}

table Escola_Externo as Escola {
  id int [pk]
  sigla varchar
}